<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ella-csm.pane-gist</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/Users/YOU/.local/bin/pane-gist-all</string></array>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/.cache/pane-gist/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/YOU/.cache/pane-gist/launchd.err</string>
</dict>
</plist>
