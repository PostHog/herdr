<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ella-csm.heard</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>-c</string><string>export PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; exec python3 -I $HOME/morning-launch/heard/heard.py check</string></array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/morning-launch/heard/log/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/YOU/morning-launch/heard/log/launchd.err</string>
</dict>
</plist>
