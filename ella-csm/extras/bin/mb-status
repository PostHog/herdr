#!/usr/bin/env python3
"""mb-status — is the hogli Metabase login still good? Prints {"us": .., "eu": ..}
with "ok", "out" (log in again) or "unknown" (hogli missing, network trouble, or
a failure that doesn't look like auth). Cheapest check per the hogli notes: list
databases. Regions are checked in parallel. HOGLI overrides the binary (tests)."""
import json, os, re, subprocess
from concurrent.futures import ThreadPoolExecutor

hogli = os.environ.get("HOGLI", os.path.expanduser("~/.local/bin/hogli"))
AUTH = re.compile(r"log ?in|expired|unauthori[sz]ed|\b40[13]\b|cookie|sso|session", re.I)


def check(region):
    try:
        r = subprocess.run([hogli, "metabase:databases", "--region", region],
                           capture_output=True, text=True, timeout=25)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    if r.returncode == 0:
        return "ok" if "ENGINE" in r.stdout else "out"  # a 200 without the list is the login page
    return "out" if AUTH.search(r.stdout + r.stderr) else "unknown"


regions = ("us", "eu")
with ThreadPoolExecutor(len(regions)) as pool:
    print(json.dumps(dict(zip(regions, pool.map(check, regions)))))
